{
  "dialect": "https://json-schema.org/draft/2020-12/schema",
  "types": [
    "array",
    "boolean",
    "date",
    "datetime",
    "enum",
    "integer",
    "number",
    "object",
    "string"
  ],
  "constraints": {
    "string": [
      [
        "minLength",
        "Minimum length"
      ],
      [
        "maxLength",
        "Maximum length"
      ],
      [
        "pattern",
        "Regular expression pattern"
      ],
      [
        "not",
        "Blocked values, comma separated"
      ]
    ],
    "number": [
      [
        "exclusiveMinimum",
        "Greater than"
      ],
      [
        "minimum",
        "Greater than or equal to"
      ],
      [
        "exclusiveMaximum",
        "Less than"
      ],
      [
        "maximum",
        "Less than or equal to"
      ],
      [
        "multipleOf",
        "Multiple of"
      ]
    ],
    "array": [
      [
        "minItems",
        "Minimum items"
      ],
      [
        "maxItems",
        "Maximum items"
      ]
    ]
  },
  "groups": {
    "Text": [
      "join",
      "concat",
      "template",
      "upper",
      "lower",
      "title",
      "capitalize",
      "trim",
      "replace",
      "slice",
      "initials",
      "slug",
      "length",
      "pad",
      "mask"
    ],
    "Numbers": [
      "sum",
      "subtract",
      "multiply",
      "divide",
      "average",
      "min",
      "max",
      "abs",
      "round",
      "percent",
      "percent_of",
      "expr"
    ],
    "Number to words": [
      "words"
    ],
    "Dates": [
      "today",
      "now",
      "add_days",
      "add_months",
      "add_years",
      "days_between",
      "age",
      "year",
      "month",
      "day",
      "weekday",
      "format_date",
      "start_of_month",
      "end_of_month"
    ],
    "Logic, lookup and misc": [
      "coalesce",
      "if_else",
      "equals",
      "lookup",
      "constant",
      "count",
      "count_if",
      "unique",
      "uuid"
    ]
  },
  "computers": {
    "abs": {
      "signature": "abs(value: Any) -> Any",
      "summary": "Return the absolute value.",
      "examples": [
        {
          "value": "value"
        },
        null
      ]
    },
    "add_days": {
      "signature": "add_days(value: str, days: int) -> str",
      "summary": "Add (or subtract) days to an ISO date.",
      "examples": [
        {
          "value": "text",
          "days": 1
        },
        {
          "days": 1
        },
        null
      ]
    },
    "add_months": {
      "signature": "add_months(value: str, months: int) -> str",
      "summary": "Add months, clamping to the month end: `add_months(\"2026-01-31\", 1) == \"2026-02-28\"`.",
      "examples": [
        {
          "value": "text",
          "months": 1
        },
        {
          "months": 1
        },
        null
      ]
    },
    "add_years": {
      "signature": "add_years(value: str, years: int) -> str",
      "summary": "Add years, Feb 29 becomes Feb 28 on a non leap year.",
      "examples": [
        {
          "value": "text",
          "years": 1
        },
        {
          "years": 1
        },
        null
      ]
    },
    "age": {
      "signature": "age(birth_date: str, on: str | None = None) -> int",
      "summary": "Whole years from `birth_date` to `on` (today by default).",
      "examples": [
        {
          "birth_date": "text",
          "on": null
        },
        {
          "on": null
        },
        null
      ]
    },
    "average": {
      "signature": "average(*values: Any) -> float",
      "summary": "Return the mean of the values, lists are spread.",
      "examples": [
        null,
        null
      ]
    },
    "capitalize": {
      "signature": "capitalize(value: Any) -> str",
      "summary": "Capitalize the first letter.",
      "examples": [
        {
          "value": "value"
        },
        null
      ]
    },
    "coalesce": {
      "signature": "coalesce(*values: Any) -> Any",
      "summary": "Return the first non-empty value, use `?` paths so missing ones are `None`.",
      "examples": [
        null,
        null
      ]
    },
    "concat": {
      "signature": "concat(*values: Any) -> str",
      "summary": "Join the non-empty values with nothing between them.",
      "examples": [
        null,
        null
      ]
    },
    "constant": {
      "signature": "constant(value: Any) -> Any",
      "summary": "Return `value` from the options, always the same.",
