    "if_else": {
      "signature": "if_else(condition: Any, then: Any, otherwise: Any) -> Any",
      "summary": "`then` when `condition` is truthy, else `otherwise`.",
      "examples": [
        {
          "condition": "value",
          "then": "value",
          "otherwise": "value"
        },
        {
          "then": "value",
          "otherwise": "value"
        },
        {
          "otherwise": "value"
        },
        null
      ]
    },
    "initials": {
      "signature": "initials(*values: Any, sep: str = '') -> str",
